<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <ui:VisualElement name="SaveSlot" style="flex-grow: 1; flex-direction: row; align-items: center;">
        <RPGFramework.Menu.UI.SaveSlotDetails name="Details" style="flex-grow: 1; flex-direction: row; align-items: center;">
            <RPGFramework.Menu.UI.SaveSlotText variable="LocationName" name="Location" class="rpg-ui-label" style="flex-grow: 1;"/>
            <RPGFramework.Menu.UI.SaveSlotPlayTime name="PlayTime" class="rpg-ui-label" style="margin-left: 40px;"/>
            <RPGFramework.Menu.UI.SaveSlotNumber variable="Money" name="Money" class="rpg-ui-label" style="margin-left: 40px;"/>
            <RPGFramework.Menu.UI.SaveSlotCaption key="Generic/Money" name="MoneyName" class="rpg-ui-label" style="margin-left: 8px;"/>
        </RPGFramework.Menu.UI.SaveSlotDetails>
        <RPGFramework.Menu.UI.SaveSlotDate name="Written" class="rpg-ui-label" style="margin-left: 40px;"/>
        <RPGFramework.Menu.UI.SaveSlotStatus damaged-key="SaveMenu/Damaged" newer-version-key="SaveMenu/Newer_Version" name="Status" class="rpg-ui-label" style="margin-left: 40px;"/>
    </ui:VisualElement>
</ui:UXML>
