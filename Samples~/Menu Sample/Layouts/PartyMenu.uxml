<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Packages/com.rpgframework.core/Runtime/UI%20Toolkit/UIShared.uss?fileID=7433441132597879392&amp;guid=94d472c2b9a84d747912b7c0d4c5d053&amp;type=3#UIShared"/>
    <Style src="Menus.uss"/>
    <ui:VisualElement name="PartyMenu" class="rpg-menu">
        <ui:Label name="HelpLine" class="rpg-ui-label rpg-help-line"/>
        <ui:VisualElement name="ContentContainer" class="rpg-menu-content">
            <ui:VisualElement name="Party" class="rpg-party">
                <RPGFramework.Menu.UI.PartyMember party-slot="0" class="rpg-party-member">
                    <RPGFramework.Menu.UI.PartyMemberPortrait class="rpg-party-portrait"/>
                    <RPGFramework.Menu.UI.PartyMemberName sheet="Characters" class="rpg-ui-label rpg-party-name"/>
                </RPGFramework.Menu.UI.PartyMember>
                <RPGFramework.Menu.UI.PartyMember party-slot="1" class="rpg-party-member">
                    <RPGFramework.Menu.UI.PartyMemberPortrait class="rpg-party-portrait"/>
                    <RPGFramework.Menu.UI.PartyMemberName sheet="Characters" class="rpg-ui-label rpg-party-name"/>
                </RPGFramework.Menu.UI.PartyMember>
                <RPGFramework.Menu.UI.PartyMember party-slot="2" class="rpg-party-member">
                    <RPGFramework.Menu.UI.PartyMemberPortrait class="rpg-party-portrait"/>
                    <RPGFramework.Menu.UI.PartyMemberName sheet="Characters" class="rpg-ui-label rpg-party-name"/>
                </RPGFramework.Menu.UI.PartyMember>
                <RPGFramework.Menu.UI.PartyMember party-slot="3" class="rpg-party-member">
                    <RPGFramework.Menu.UI.PartyMemberPortrait class="rpg-party-portrait"/>
                    <RPGFramework.Menu.UI.PartyMemberName sheet="Characters" class="rpg-ui-label rpg-party-name"/>
                </RPGFramework.Menu.UI.PartyMember>
            </ui:VisualElement>
            <ui:VisualElement name="ButtonsContainer" class="rpg-menu-buttons">
                <RPGFramework.Menu.UI.MenuEntry opens="Config" help="PartyMenu/ConfigHelp" text="Config">
                    <Bindings>
                        <RPGFramework.Localisation.StaticLocalisedText property="text" key="Generic/Settings"/>
                    </Bindings>
                </RPGFramework.Menu.UI.MenuEntry>
                <RPGFramework.Menu.UI.MenuEntry opens="Save" help="PartyMenu/SaveHelp" text="Save">
                    <Bindings>
                        <RPGFramework.Localisation.StaticLocalisedText property="text" key="PartyMenu/Save"/>
                    </Bindings>
                </RPGFramework.Menu.UI.MenuEntry>
                <RPGFramework.Menu.UI.MenuEntry opens="Load" help="PartyMenu/LoadHelp" text="Load">
                    <Bindings>
                        <RPGFramework.Localisation.StaticLocalisedText property="text" key="PartyMenu/Load"/>
                    </Bindings>
                </RPGFramework.Menu.UI.MenuEntry>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="FooterContainer" class="rpg-menu-footer">
            <ui:Label text="Location" name="LocationLabel" class="rpg-ui-label">
                <Bindings>
                    <RPGFramework.Localisation.DynamicLocalisedText property="text" sheet="Locations"/>
                </Bindings>
            </ui:Label>
            <ui:VisualElement name="PlayTime">
                <ui:Label text="Time" name="TimeLabel" class="rpg-ui-label">
                    <Bindings>
                        <RPGFramework.Localisation.StaticLocalisedText property="text" key="PartyMenu/Time"/>
                    </Bindings>
                </ui:Label>
                <ui:Label text="0:00" name="PlayTimeLabel" class="rpg-ui-label"/>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
